App(
    appid="wavehound",
    name="Wavehound",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="wavehound_app",
    requires=["gui", "storage", "notification"],
    stack_size=4 * 1024,
    fap_category="GPIO",
    fap_icon="wavehound.png",
    fap_file_assets="assets",
    fap_version="2.0",
    fap_description="WiFi fox hunting for the ESP32 Marauder (v1.19.0) dev board",
    fap_author="Mathias Kiermeier",
    fap_weburl="https://github.com/MatKier/flipperzero-marauder-wavehound",
)
